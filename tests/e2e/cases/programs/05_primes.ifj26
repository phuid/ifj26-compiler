def isPrime(n: Int): Int =
  if n < 2 then
    return 0
  else
    ()
  var d = 2
  while d * d <= n do
    if n - (n / d) * d == 0 then
      return 0
    else
      ()
    d = d + 1
  1

@main def run(): Unit =
