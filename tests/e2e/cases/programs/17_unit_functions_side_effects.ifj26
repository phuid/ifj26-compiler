import ifj26.*

def stars(n: Int): Unit =
  var i = 0
  while i < n do
    print("*")
    i = i + 1
  print("\n")

def triangle(height: Int): Unit =
  var row = 1
  while row <= height do
    stars(row)
    row = row + 1

@main def run(): Unit =
  triangle(3)
