import ifj26.*

def gcd(x: Int, y: Int): Int =
  var a = x
  var b = y
  while b != 0 do
    val t = a - (a / b) * b
    a = b
    b = t
  a

@main def run(): Unit =
  val x = readInt()
  val y = readInt()
  val g = gcd(x, y)
  val l = x / g * y
  print("gcd=")
  print(g)
  print(" lcm=")
  print(l)
  print("\n")
