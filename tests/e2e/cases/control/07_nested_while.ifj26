// AI-generated test - nested while loops print a 3x3 multiplication table.
// Model: claude-opus-5-5 (Claude Code).
// Prompt: Write valid IFJ26 programs about if and while for plan-e2e.md 3.4 with their exact expected stdout.
import ifj26.*

@main def run(): Unit =
  var i = 1
  while i <= 3 do
    var j = 1
    while j <= 3 do
      val p = i * j
      print(p)
      print(" ")
      j = j + 1
    print("\n")
    i = i + 1
