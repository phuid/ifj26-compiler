import ifj26.*

def classify(n: Int): Unit =
  if n < 0 then
    print("neg ")
  else
    if n == 0 then
      print("zero ")
    else
      print("pos ")

@main def run(): Unit =
  val a = -3
  val b = 0
  val c = 8
  classify(a)
  classify(b)
  classify(c)
