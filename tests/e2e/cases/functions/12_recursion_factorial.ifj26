// AI-generated test - recursive factorial ending with an if whose branches return.
// Model: claude-opus-5-5 (Claude Code).
// Prompt: Write valid IFJ26 programs about user functions for plan-e2e.md 3.5 with their exact expected stdout.
import ifj26.*

def fact(n: Int): Int =
  if n <= 1 then
    return 1
  else
    val m = n - 1
    val r = fact(m)
    return n * r

@main def run(): Unit =
  val r = fact(10)
  print(r)
