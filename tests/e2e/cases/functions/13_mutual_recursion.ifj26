import ifj26.*

def isEven(n: Int): Int =
  if n == 0 then
    return 1
  else
    val m = n - 1
    return isOdd(m)

def isOdd(n: Int): Int =
  if n == 0 then
    return 0
  else
    val m = n - 1
    return isEven(m)

@main def run(): Unit =
  val a = isEven(10)
  val b = isEven(7)
  print(a)
  print(b)
