.IFJcode26
DEFVAR GF@trash
CALL test
EXIT int@0
LABEL print
CREATEFRAME
PUSHFRAME
DEFVAR LF@val
POPS LF@val
DEFVAR LF@type
TYPE LF@type LF@val
JUMPIFEQ $print_unit LF@type string@nil
WRITE LF@val
JUMP $print_end
LABEL $print_unit
WRITE string@()
LABEL $print_end
PUSHS nil@nil
POPFRAME
RETURN
LABEL readLine
CREATEFRAME
PUSHFRAME
DEFVAR LF@res
READ LF@res string
DEFVAR LF@type
TYPE LF@type LF@res
JUMPIFNEQ $readLine_ok LF@type string@nil
MOVE LF@res string@
LABEL $readLine_ok
PUSHS LF@res
POPFRAME
RETURN
LABEL readInt
CREATEFRAME
PUSHFRAME
DEFVAR LF@res
READ LF@res int
DEFVAR LF@type
TYPE LF@type LF@res
JUMPIFNEQ $readInt_ok LF@type string@nil
MOVE LF@res int@0
LABEL $readInt_ok
PUSHS LF@res
POPFRAME
RETURN
LABEL readDouble
CREATEFRAME
PUSHFRAME
DEFVAR LF@res
READ LF@res float
DEFVAR LF@type
TYPE LF@type LF@res
JUMPIFNEQ $readDouble_ok LF@type string@nil
MOVE LF@res float@0x0p+0
LABEL $readDouble_ok
PUSHS LF@res
POPFRAME
RETURN
LABEL readBoolean
CREATEFRAME
PUSHFRAME
DEFVAR LF@res
READ LF@res bool
DEFVAR LF@type
TYPE LF@type LF@res
JUMPIFNEQ $readBoolean_ok LF@type string@nil
MOVE LF@res bool@false
LABEL $readBoolean_ok
PUSHS LF@res
POPFRAME
RETURN
LABEL toStr
CREATEFRAME
PUSHFRAME
DEFVAR LF@val
POPS LF@val
DEFVAR LF@type
TYPE LF@type LF@val
DEFVAR LF@res
JUMPIFEQ $toStr_int LF@type string@int
JUMPIFEQ $toStr_float LF@type string@float
JUMPIFEQ $toStr_bool LF@type string@bool
JUMPIFEQ $toStr_unit LF@type string@nil
MOVE LF@res LF@val
JUMP $toStr_end
LABEL $toStr_int
INT2STR LF@res LF@val
JUMP $toStr_end
LABEL $toStr_float
FLOAT2STR LF@res LF@val
JUMP $toStr_end
LABEL $toStr_bool
JUMPIFEQ $toStr_true LF@val bool@true
MOVE LF@res string@false
JUMP $toStr_end
LABEL $toStr_true
MOVE LF@res string@true
JUMP $toStr_end
LABEL $toStr_unit
MOVE LF@res string@()
LABEL $toStr_end
PUSHS LF@res
POPFRAME
RETURN
LABEL toInt
CREATEFRAME
PUSHFRAME
DEFVAR LF@val
POPS LF@val
DEFVAR LF@res
FLOAT2INT LF@res LF@val
PUSHS LF@res
POPFRAME
RETURN
LABEL strLength
CREATEFRAME
PUSHFRAME
DEFVAR LF@val
POPS LF@val
DEFVAR LF@res
STRLEN LF@res LF@val
PUSHS LF@res
POPFRAME
RETURN
LABEL subStr
CREATEFRAME
PUSHFRAME
DEFVAR LF@end
POPS LF@end
DEFVAR LF@start
POPS LF@start
DEFVAR LF@val
POPS LF@val
DEFVAR LF@len
STRLEN LF@len LF@val
DEFVAR LF@cond
LT LF@cond LF@start int@0
JUMPIFEQ $subStr_err LF@cond bool@true
LT LF@cond LF@end int@0
JUMPIFEQ $subStr_err LF@cond bool@true
GT LF@cond LF@start LF@end
JUMPIFEQ $subStr_err LF@cond bool@true
LT LF@cond LF@start LF@len
JUMPIFEQ $subStr_err LF@cond bool@false
GT LF@cond LF@end LF@len
JUMPIFEQ $subStr_err LF@cond bool@true
DEFVAR LF@res
MOVE LF@res string@
DEFVAR LF@ch
LABEL $subStr_loop
JUMPIFEQ $subStr_end LF@start LF@end
GETCHAR LF@ch LF@val LF@start
CONCAT LF@res LF@res LF@ch
ADD LF@start LF@start int@1
JUMP $subStr_loop
LABEL $subStr_err
EXIT int@40
LABEL $subStr_end
PUSHS LF@res
POPFRAME
RETURN
LABEL ord
CREATEFRAME
PUSHFRAME
DEFVAR LF@idx
POPS LF@idx
DEFVAR LF@val
POPS LF@val
DEFVAR LF@res
DEFVAR LF@len
STRLEN LF@len LF@val
DEFVAR LF@cond
LT LF@cond LF@idx int@0
JUMPIFEQ $ord_bad LF@cond bool@true
LT LF@cond LF@idx LF@len
JUMPIFEQ $ord_bad LF@cond bool@false
STRI2INT LF@res LF@val LF@idx
JUMP $ord_end
LABEL $ord_bad
MOVE LF@res int@-1
LABEL $ord_end
PUSHS LF@res
POPFRAME
RETURN
LABEL chr
CREATEFRAME
PUSHFRAME
DEFVAR LF@code
POPS LF@code
DEFVAR LF@res
INT2CHAR LF@res LF@code
PUSHS LF@res
POPFRAME
RETURN
LABEL test
CREATEFRAME
PUSHFRAME
DEFVAR LF@x$0
CALL readLine
PUSHS int@0
PUSHS int@3
CALL subStr
POPS LF@x$0
PUSHS LF@x$0
CALL print
POPS GF@trash
PUSHS nil@nil
POPFRAME
RETURN
