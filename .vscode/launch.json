{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Debug C",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceFolder}/ifj26-compiler",
            "args": [],
            "cwd": "${workspaceFolder}",
            "stopAtEntry": false,
            "externalConsole": false,
            "MIMode": "gdb",
            "miDebuggerPath": "/usr/bin/gdb",
            "preLaunchTask": "make",
            "setupCommands": [
                {
                    "description": "Redirect stdin",
                    "text": "set exec-wrapper sh -c 'exec \"$@\" < prog.ifj26' sh",
                    "ignoreFailures": false
                }
            ]
        }
    ]
}